---
// Paste these lines inside <head> in your layout (e.g. src/layouts/Layout.astro).
// Files from /icons and /og go in /public.
const lang = Astro.currentLocale ?? 'es';
---
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#121611" />
<meta property="og:image" content={new URL(`/og-${lang}.png`, Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={new URL(`/og-${lang}.png`, Astro.site)} />
