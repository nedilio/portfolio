---
import { ArrowRight } from 'lucide-react';
import SectionLabel from './SectionLabel.astro';
import Icon from './Icon.astro';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { profile } from '@/data/profile';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
  <div class="glass relative overflow-hidden rounded-[2.5rem] px-6 py-14 text-center sm:px-12 sm:py-20">
    <div
      class="absolute -top-24 left-1/2 -z-10 size-80 -translate-x-1/2 rounded-full blur-3xl"
      style="background: var(--blob-1)"
      aria-hidden="true"
    >
    </div>
    <SectionLabel text={t('contact.label')} />
    <h2 class="mx-auto mt-6 max-w-2xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
      {t('contact.title')}
    </h2>
    <p class="text-muted-foreground mx-auto mt-4 max-w-lg text-lg">{t('contact.text')}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={`mailto:${profile.email}`}
        class="bg-lime text-lime-foreground inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-sm font-semibold shadow-[0_8px_30px_-8px_var(--lime)] transition hover:-translate-y-0.5"
      >
        {t('contact.cta')} <ArrowRight className="size-4" />
      </a>
      <a
        href={profile.socials.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="glass inline-flex items-center gap-2 rounded-full px-5 py-3.5 text-sm font-semibold"
      >
        <Icon name="linkedin" /> LinkedIn
      </a>
      <a
        href={profile.socials.github}
        target="_blank"
        rel="noopener noreferrer"
        class="glass inline-flex items-center gap-2 rounded-full px-5 py-3.5 text-sm font-semibold"
      >
        <Icon name="github" /> GitHub
      </a>
    </div>
  </div>
</section>
