---
import { ArrowUpRight } from 'lucide-react';
import SectionLabel from './SectionLabel.astro';
import ProjectVisual from './ProjectVisual.astro';
import Icon from './Icon.astro';
import type { Lang } from '@/i18n/ui';
import { formatMonth, l, useTranslations } from '@/i18n/utils';
import { otherProjects, type Project } from '@/data/projects';
import { profile } from '@/data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const tintClass: Record<Project['tint'], string> = {
  lime: 'bg-tint-lime',
  lavender: 'bg-tint-lavender',
  pink: 'bg-tint-pink',
  amber: 'bg-tint-amber',
};
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
  <div class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <SectionLabel text={t('projects.label')} />
    <h2 class="max-w-xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl md:text-right">
      {t('projects.title.a')} <span class="text-muted-foreground">{t('projects.title.b')}</span>
    </h2>
  </div>

  <ul class="flex flex-col gap-5">
    {
      otherProjects.map((p, i) => (
        <li class="grid gap-5 md:grid-cols-2">
          <article
            class:list={[
              'glass flex flex-col justify-between gap-8 rounded-[2rem] p-6 sm:p-8',
              tintClass[p.tint],
              i % 2 === 1 && 'md:order-2',
            ]}
          >
            <ul class="flex flex-wrap gap-2">
              {p.tags.map((tag) => (
                <li class="bg-background/60 rounded-full border px-3 py-1 font-mono text-[11px] uppercase">{tag}</li>
              ))}
            </ul>
            <div>
              {p.start && (
                <p class="text-muted-foreground mb-2 font-mono text-xs uppercase">
                  {t('projects.timeline')} <span class="text-lime-strong">•</span> {formatMonth(p.start, lang, '')} –{' '}
                  {formatMonth(p.end ?? null, lang, t('exp.present'))}
                </p>
              )}
              <h3 class="text-2xl font-semibold tracking-tight">
                {p.title} <span class="text-muted-foreground">— {l(p.subtitle, lang)}</span>
              </h3>
              <p class="text-muted-foreground mt-3 leading-relaxed">{l(p.summary, lang)}</p>
              <p class="mt-4 text-sm">{p.stack.join(' · ')}</p>
              {(p.live || p.repo) && (
                <div class="mt-6 flex flex-wrap gap-3">
                  {p.live && (
                    <a
                      href={p.live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-lime text-lime-foreground inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-xs font-semibold"
                    >
                      {t('projects.visit')} <ArrowUpRight className="size-3.5" />
                    </a>
                  )}
                  {p.repo && (
                    <a
                      href={p.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="glass inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-xs font-semibold"
                    >
                      <Icon name="github" class="size-3.5" /> {t('projects.code')}
                    </a>
                  )}
                </div>
              )}
            </div>
          </article>
          <ProjectVisual project={p} class="min-h-64 md:min-h-80" />
        </li>
      ))
    }
  </ul>

  <div class="mt-10 flex justify-center">
    <a
      href={profile.socials.github}
      target="_blank"
      rel="noopener noreferrer"
      class="glass inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition hover:-translate-y-0.5"
    >
      <Icon name="github" /> {t('projects.more')}
    </a>
  </div>
</section>
