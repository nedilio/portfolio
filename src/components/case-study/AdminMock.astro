---
// Illustration of the admin dashboard, recreated from the Reset Coffee source (admin/page.tsx,
// ClientsTable). Customer names are fictitious.
import { Plus, RotateCcw, Search } from 'lucide-react';

interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;
const rows = [
  { name: 'Camila Rojas', coffees: 9 },
  { name: 'Diego Fuentes', coffees: 6 },
  { name: 'Valentina Soto', coffees: 3 },
  { name: 'Matías Herrera', coffees: 1 },
];
const t =
  lang === 'es'
    ? { search: 'Buscar cliente…', client: 'Cliente', coffees: 'Cafés', actions: 'Acciones', page: 'Página 1 de 8' }
    : { search: 'Search customer…', client: 'Customer', coffees: 'Coffees', actions: 'Actions', page: 'Page 1 of 8' };
---

<div class="overflow-hidden rounded-xl border border-[#3c5a41]/15 bg-white text-neutral-900 shadow-sm">
  <div class="flex items-center gap-2 border-b border-neutral-100 px-4 py-3 text-sm text-neutral-400">
    <Search className="size-4" />
    {t.search}
  </div>
  <table class="w-full text-left text-sm">
    <thead class="bg-neutral-50 text-xs text-neutral-500">
      <tr>
        <th class="px-4 py-2 font-medium">{t.client}</th>
        <th class="px-4 py-2 font-medium">{t.coffees}</th>
        <th class="px-4 py-2 text-right font-medium">{t.actions}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr class="border-t border-neutral-100">
            <td class="px-4 py-2.5">
              <span class="flex items-center gap-2">
                <span class="flex size-7 items-center justify-center rounded-full bg-[#3c5a41]/10 text-[10px] font-bold text-[#3c5a41]">
                  {r.name.split(' ').map((w) => w[0]).join('')}
                </span>
                {r.name}
              </span>
            </td>
            <td class="px-4 py-2.5">
              <span class:list={['font-semibold tabular-nums', r.coffees >= 9 && 'text-[#d9772b]']}>{r.coffees}</span>
              <span class="text-neutral-400"> / 9</span>
            </td>
            <td class="px-4 py-2.5">
              <span class="flex justify-end gap-1.5">
                {r.coffees >= 9 ? (
                  <span class="inline-flex items-center gap-1 rounded-md bg-[#f4a259]/20 px-2 py-1 text-xs font-semibold text-[#b85d1a]">
                    <RotateCcw className="size-3" /> {lang === 'es' ? 'Canjear' : 'Redeem'}
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1 rounded-md bg-[#3c5a41] px-2 py-1 text-xs font-semibold text-white">
                    <Plus className="size-3" /> 1
                  </span>
                )}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <div class="border-t border-neutral-100 px-4 py-2 text-right text-xs text-neutral-400">{t.page}</div>
</div>
