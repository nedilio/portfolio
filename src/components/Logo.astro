---
// Inline, theme-aware logo. Colors follow the semantic tokens in brand.css,
// so it flips automatically between light and dark mode.
// Usage: <Logo />  ·  <Logo variant="mark" size={32} />  ·  <Logo size={28} />
interface Props {
  variant?: 'full' | 'mark';
  size?: number; // height in px
  class?: string;
}
const { variant = 'full', size = 32, class: className } = Astro.props;
---
{variant === 'mark' ? (
  <svg viewBox="0 0 96 96" height={size} width={size} class={className} role="img" aria-label="nedilio.dev">
    <path fill="var(--fg)" d="M6 26a18 18 0 0 1 18-18h48a18 18 0 0 1 18 18v26a18 18 0 0 1-18 18H24A18 18 0 0 1 6 52z" />
    <path fill="var(--bg)" stroke="var(--bg)" stroke-width="1.5" stroke-linejoin="round" d="M33 56V22h9l13 21V22h8v34h-9L41 35v21z" />
    <path fill="var(--color-lime)" d="M38 80h20a4 4 0 0 1 0 8H38a4 4 0 0 1 0-8z" />
  </svg>
) : (
  <span class:list={['inline-flex items-center gap-2.5', className]} aria-label="nedilio.dev">
    <svg viewBox="0 0 96 96" height={size} width={size} aria-hidden="true">
      <path fill="var(--fg)" d="M6 26a18 18 0 0 1 18-18h48a18 18 0 0 1 18 18v26a18 18 0 0 1-18 18H24A18 18 0 0 1 6 52z" />
      <path fill="var(--bg)" stroke="var(--bg)" stroke-width="1.5" stroke-linejoin="round" d="M33 56V22h9l13 21V22h8v34h-9L41 35v21z" />
      <path fill="var(--color-lime)" d="M38 80h20a4 4 0 0 1 0 8H38a4 4 0 0 1 0-8z" />
    </svg>
    <span
      aria-hidden="true"
      class="font-display font-semibold text-[var(--fg)]"
      style={`font-size:${Math.round(size * 0.66)}px;letter-spacing:-0.045em;line-height:1`}
    >nedilio<span class="text-[var(--accent-text)]">.</span><span class="text-muted-foreground">dev</span></span>
  </span>
)}
