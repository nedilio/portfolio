---
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { stack } from '@/data/profile';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
const items = [...stack.frontend, ...stack.backend, ...stack.tools];
---

<section class="mx-auto max-w-6xl px-4 py-14" aria-labelledby="stack-title">
  <p id="stack-title" class="text-muted-foreground mb-6 text-center text-sm">{t('stack.title')}</p>
  <div class="relative overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_12%,black_88%,transparent)]">
    <ul class="animate-marquee flex w-max gap-3 hover:[animation-play-state:paused]">
      {
        [...items, ...items].map((item, i) => (
          <li class="glass rounded-full px-5 py-2 text-sm font-medium whitespace-nowrap" aria-hidden={i >= items.length ? 'true' : undefined}>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
